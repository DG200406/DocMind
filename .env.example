# Embedding model used to build the FAISS index (HuggingFace sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cross-encoder used to re-rank the top retrieved chunks
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Which LLM answers questions: huggingface | openai | anthropic
LLM_PROVIDER=huggingface

# Used when LLM_PROVIDER=huggingface (local, no API key needed)
HF_LLM_MODEL=google/flan-t5-small

# Used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K_RETRIEVE=20
TOP_N_CONTEXT=4

# Storage
DOCS_DIR=data/documents
INDEX_DIR=data/index
